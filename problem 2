import java.util.Scanner;
public class Main {
    public static double coneVolume(double dValue, double hValue) {
        double r = dValue / 2;
        return (1.0 / 3) * Math.PI * r * r * hValue;
    }
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Enter diameter: ");
        double dValue = input.nextDouble();
        System.out.print("Enter height: ");
        double hValue = input.nextDouble();
        double volume = coneVolume(dValue, hValue);
        System.out.printf("Cone volume: %.2f%n", volume);
        input.close();
    }
}
